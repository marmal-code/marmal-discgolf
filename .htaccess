Options -Indexes
<FilesMatch "^(config(\.sample)?\.php|\.gitignore)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(\.git|inc|lib|migrations|seed|docs)(/|$)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Veřejný prodej má koncovku .html (interně prodej.php); přímý přístup na .php přesměrujeme
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} \s/+(.*/)?prodej\.php[\s?]
    RewriteRule ^(.*/)?prodej\.php$ $1prodej.html [R=301,L]
    RewriteRule ^(.*/)?prodej\.html$ $1prodej.php [L]
</IfModule>
